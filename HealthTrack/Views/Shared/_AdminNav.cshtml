@{
    var current = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Active(params string[] a) => a.Any(x => string.Equals(current, x, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
}
<nav class="subnav" aria-label="Admin sections">
    <a class="@Active("Dashboard")" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-grid-1x2"></i> Overview</a>
    <a class="@Active("Assignments")" asp-controller="Admin" asp-action="Assignments"><i class="bi bi-diagram-2"></i> Assignments</a>
    <a class="@Active("Users", "ResetPassword")" asp-controller="Admin" asp-action="Users"><i class="bi bi-people"></i> Users</a>
    <a class="@Active("Reports")" asp-controller="Admin" asp-action="Reports"><i class="bi bi-bar-chart-line"></i> Reports</a>
</nav>
