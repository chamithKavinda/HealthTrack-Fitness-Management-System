@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="py-4">
    <div class="panel" style="max-width: 720px; margin: 0 auto;">
        <div class="d-flex align-items-center gap-3 mb-3">
            <div class="avatar" style="background:var(--pulse-light); color:var(--pulse); border-color:var(--pulse-border);">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            </div>
            <div>
                <h1 class="fs-4 fw-bold mb-0 text-danger">An unexpected error occurred</h1>
                <p class="text-muted small mb-0">We encountered an issue while processing your request.</p>
            </div>
        </div>

        @if (Model.ShowRequestId)
        {
            <div class="p-3 mb-3 rounded-3" style="background:var(--canvas-subtle); border: 1px solid var(--line);">
                <span class="text-muted small">Tracking Request ID:</span>
                <code class="fw-bold ms-1" style="color:var(--primary);">@Model.RequestId</code>
            </div>
        }

        <div class="pt-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="bi bi-arrow-left"></i> Return Home</a>
        </div>
    </div>
</div>
