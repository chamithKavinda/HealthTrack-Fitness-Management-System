@{
    var current = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool On(params string[] a) => a.Any(x => string.Equals(current, x, StringComparison.OrdinalIgnoreCase));
}
<nav class="subnav" aria-label="Trainer sections">
    <a class="@(On("Dashboard") ? "active" : "")" asp-controller="Trainer" asp-action="Dashboard"><i class="bi bi-grid-1x2"></i> Overview</a>
    <a class="@(On("Clients") ? "active" : "")" asp-controller="Trainer" asp-action="Clients"><i class="bi bi-people"></i> My clients</a>
    <a class="@(On("Appointments") ? "active" : "")" asp-controller="Trainer" asp-action="Appointments"><i class="bi bi-calendar-check"></i> Appointments</a>
    <a class="@(On("Plans", "NewPlan", "WorkoutPlanDetails", "DietPlanDetails", "AddWorkoutItem", "AddDietItem") ? "active" : "")" asp-controller="Trainer" asp-action="Plans"><i class="bi bi-clipboard2-pulse"></i> Plans</a>
    <a class="@(On("Feedback", "SendFeedback") ? "active" : "")" asp-controller="Trainer" asp-action="Feedback"><i class="bi bi-chat-left-text"></i> Feedback</a>
    <a class="@(On("Reports") ? "active" : "")" asp-controller="Trainer" asp-action="Reports"><i class="bi bi-bar-chart-line"></i> Reports</a>
</nav>
