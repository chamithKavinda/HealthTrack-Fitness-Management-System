@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="dash-head">
    <h1>Privacy Policy</h1>
    <p class="text-muted mb-0">How HealthTrack safeguards your fitness data and personal health information.</p>
</div>

<div class="panel">
    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
        <div class="avatar" style="background:var(--success-light); color:var(--success); border-color:var(--success-border);">
            <i class="bi bi-shield-check" style="font-size:1.25rem;"></i>
        </div>
        <div>
            <div class="fw-bold fs-5">Health Data Protection Guarantee</div>
            <div class="text-muted small">Updated for 2026 HealthTrack Standards</div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <h3 class="fs-6 fw-bold text-dark mb-2"><i class="bi bi-lock text-primary me-2"></i>Medical Notes & Encryption</h3>
            <p class="text-muted small">Sensitive medical history and trainer notes are protected using industry-standard symmetric encryption prior to persistence. Only authenticated participants can access corresponding records.</p>
        </div>
        <div class="col-md-6">
            <h3 class="fs-6 fw-bold text-dark mb-2"><i class="bi bi-person-check text-primary me-2"></i>Trainer-Client Confidentiality</h3>
            <p class="text-muted small">Workout logs, diet charts, and biometrics are strictly shared between you and your appointed trainer, overseen by platform administrators for compliance.</p>
        </div>
    </div>
</div>
