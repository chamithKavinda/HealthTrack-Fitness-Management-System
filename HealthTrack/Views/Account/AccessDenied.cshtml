@{
    ViewData["Title"] = "Access Denied";
}

<div class="py-5 mx-auto" style="max-width:540px">
    <div class="panel text-center py-5 px-4">
        <div class="d-inline-grid place-content-center mx-auto mb-3" style="width:64px; height:64px; border-radius:50%; background:var(--warn-light); color:var(--warn); font-size:1.85rem; border:1px solid var(--warn-border);">
            <i class="bi bi-shield-lock"></i>
        </div>
        <h1 class="mb-2" style="font-size:1.85rem; font-weight:800;">Access Restricted</h1>
        <p class="text-muted mb-4 mx-auto" style="max-width:380px;">Your current account permissions do not grant access to this page. Please return to your workspace dashboard.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg"><i class="bi bi-house-door"></i> Return to Dashboard</a>
    </div>
</div>
