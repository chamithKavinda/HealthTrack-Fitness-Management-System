@using System.Globalization
@model HealthTrack.Models.AdminReportsViewModel
@{
    ViewData["Title"] = "Reports";
    var rate = Model.Appointments > 0 ? (int)Math.Round(Model.CompletedAppointments * 100.0 / Model.Appointments) : 0;
}
<div class="dash-head d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <h1>System reports</h1>
        <p class="text-muted mb-0">Growth, activity and trainer workload across HealthTrack.</p>
    </div>
    <div class="d-flex flex-wrap gap-2 no-print">
        <a class="btn btn-outline-secondary btn-sm" asp-action="ExportAppointments"><i class="bi bi-filetype-csv"></i> Appointments CSV</a>
        <a class="btn btn-outline-secondary btn-sm" asp-action="ExportUsers"><i class="bi bi-filetype-csv"></i> Users CSV</a>
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
    </div>
</div>

<section class="scoreboard mb-4">
    <div class="cell"><span class="label">Clients</span><span class="score">@Model.Clients</span></div>
    <div class="cell"><span class="label">Trainers</span><span class="score">@Model.Trainers</span></div>
    <div class="cell"><span class="label">Active assignments</span><span class="score">@Model.ActiveAssignments</span></div>
    <div class="cell"><span class="label">Appointments</span><span class="score">@Model.Appointments</span></div>
    <div class="cell"><span class="label">Completed</span><span class="score">@rate</span><span class="unit">%</span></div>
</section>

<div class="row g-4 mb-4">
    <div class="col-lg-7"><div class="panel"><h2>New sign-ups, 8 weeks</h2><div class="chart-box"><canvas id="growthChart" aria-label="New clients and trainers per week"></canvas></div></div></div>
    <div class="col-lg-5"><div class="panel"><h2>Appointments by status</h2><div class="chart-box"><canvas id="statusChart" aria-label="Appointments by status"></canvas></div></div></div>
    <div class="col-12"><div class="panel"><h2>Logged activity, 14 days</h2><div class="chart-box"><canvas id="activityChart" aria-label="Workouts, meals and measurements logged per day"></canvas></div></div></div>
</div>

<div class="panel">
    <h2>Trainer workload</h2>
    @if (!Model.Workload.Any()) { <p class="empty mb-0">No trainers yet.</p> }
    else
    {
        <div class="table-responsive">
            <table class="report-table">
                <thead><tr><th>Trainer</th><th>Specialization</th><th>Active clients</th><th>Plans</th><th>Appointments</th><th>Completed</th><th>Completion</th></tr></thead>
                <tbody>
                @foreach (var t in Model.Workload)
                {
                    <tr>
                        <td class="fw-semibold">@t.Name</td>
                        <td>@(t.Specialization ?? "-")</td>
                        <td>@t.ActiveClients</td>
                        <td>@t.Plans</td>
                        <td>@t.Appointments</td>
                        <td>@t.Completed</td>
                        <td>@if (t.CompletionPct is int p) { <div class="bar" title="@p%"><span style="width:@p%"></span></div><small>@p%</small> } else { <span class="item-sub">-</span> }</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
<script id="report-data" type="application/json">@Json.Serialize(Model.Chart)</script>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
