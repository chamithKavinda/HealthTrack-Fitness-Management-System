@model HealthTrack.Models.DietPlanDetailsViewModel
@{ ViewData["Title"] = Model.Title; }
<div class="dash-head d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <a class="back-link" asp-action="Plans"><i class="bi bi-arrow-left"></i> All plans</a>
        <h1>@Model.Title</h1>
        <p class="text-muted mb-0">For @Model.ClientName · @Model.Start.ToString("dd MMM yyyy")@(Model.End is DateOnly e ? " to " + e.ToString("dd MMM yyyy") : "")</p>
    </div>
    <form asp-action="DeleteDietPlan" asp-route-id="@Model.Id" method="post" data-confirm="Delete this whole plan?">
        <button class="btn btn-outline-danger btn-sm" type="submit"><i class="bi bi-trash3"></i> Delete plan</button>
    </form>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <form class="panel" asp-action="AddDietItem" asp-route-id="@Model.Id" method="post" novalidate>
            <h2>Add a meal</h2>
            <div class="form-floating mb-1">
                <select asp-for="Input.DayOfWeek" class="form-select">
                    @foreach (var d in HealthTrack.Models.PlanDays.All) { <option value="@d" selected="@(Model.Input.DayOfWeek == d)">@d</option> }
                </select>
                <label asp-for="Input.DayOfWeek"></label>
            </div>
            <span asp-validation-for="Input.DayOfWeek" class="field-error"></span>
            <div class="form-floating mb-1 mt-2">
                <select asp-for="Input.MealType" class="form-select">
                    @foreach (var m in HealthTrack.Models.PlanDays.Meals) { <option value="@m" selected="@(Model.Input.MealType == m)">@m</option> }
                </select>
                <label asp-for="Input.MealType"></label>
            </div>
            <span asp-validation-for="Input.MealType" class="field-error"></span>
            <div class="form-floating mb-1 mt-2">
                <input asp-for="Input.FoodDescription" class="form-control" placeholder="Food" />
                <label asp-for="Input.FoodDescription"></label>
            </div>
            <span asp-validation-for="Input.FoodDescription" class="field-error"></span>
            <div class="form-floating mb-1 mt-2">
                <input asp-for="Input.Calories" type="number" class="form-control" placeholder="Calories" />
                <label asp-for="Input.Calories"></label>
            </div>
            <span asp-validation-for="Input.Calories" class="field-error"></span>
            <button class="btn btn-primary w-100 mt-3" type="submit" data-loading>Add meal</button>
        </form>
    </div>
    <div class="col-lg-8">
        <div class="panel">
            <h2>Weekly menu</h2>
            @if (!Model.Days.Any()) { <p class="empty">No meals yet. Add the first one.</p> }
            @foreach (var day in Model.Days)
            {
                <div class="day-group">
                    <div class="day-head"><strong>@day.Day</strong><span class="text-muted">@day.Kcal kcal</span></div>
                    @foreach (var i in day.Items)
                    {
                        <div class="log-row">
                            <div>
                                <div class="item-title">@i.Food</div>
                                <div class="item-sub">@i.MealType@(i.Calories is int c ? $" · {c} kcal" : "")</div>
                            </div>
                            <form asp-action="DeleteDietItem" asp-route-id="@i.Id" method="post" data-confirm="Remove this meal?">
                                <button class="icon-btn icon-btn--danger" type="submit" aria-label="Remove meal"><i class="bi bi-trash3"></i></button>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
